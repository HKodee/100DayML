   "source": [
    "import numpy as np\n",
    "\n",
    "# Simulate 10,000 coin tosses\n",
    "tosses = np.random.choice(\n",
    "    [\"Heads\", \"Tails\"],\n",
    "    size=10000\n",
    ")\n",
    "\n",
    "# Calculate the observed probability of heads\n",
    "prob_heads = np.mean(tosses == \"Heads\")\n",
    "\n",
    "print(\"Probability of heads:\", prob_heads)"
   ]
  }
 ],
